# Caddyfile — Reglas de tráfico del único punto de entrada público (Caddy).
# {$PUBLIC_DOMAIN} es una variable que Caddy lee del environment (compose).
#
# TLS: cert autofirmado (tls internal) en lugar de Let's Encrypt. ¿Por qué?
# Let's Encrypt veta emitir para *.compute.amazonaws.com por policy global
# (el dominio pertenece a AWS, no podemos probar propiedad). El cert auto-
# firmado cumple el requisito de HTTPS (getUserMedia / wss funcionan porque
# el contexto es seguro) pero el navegador tira warning la primera vez —
# el usuario lo acepta y entra. Producción real: dominio propio en Route 53.
#
# auto_https off: sin esto, Caddy intenta redirigir HTTP→HTTPS ANTES de
# evaluar el site block, y eso rompe el handshake. Con off, manejamos
# el TLS nosotros mismos desde el primer request.
#
# handle_path: matchea un prefijo de URL y hace reverse_proxy al service
# interno por la red de compose (nombre de servicio = hostname).

{
	auto_https off
}

http://{$PUBLIC_DOMAIN}, https://{$PUBLIC_DOMAIN} {
	tls internal

	# Todo lo que entra por /api/* va al backend (api:3000).
	# El navegador llama a "/api" (relativo, horneado por Vite) → mismo dominio
	# → no hay CORS que configurar. Simple y elegante.
	handle_path /api/* {
		reverse_proxy api:3000
	}

	# /collab/* → servidor Yjs/WebSocket (collab-server:1234).
	# Caddy detecta el handshake "Upgrade: websocket" y mantiene la conexión
	# bi-direccional abierta — por eso wss:// funciona sin config extra.
	handle_path /collab/* {
		reverse_proxy collab-server:1234
	}

	# Cualquier otro path → frontend estático (SPA React) servido desde /srv.
	# /srv lo llena la imagen "caddy" del Dockerfile (COPY del dist de Vite).
	# try_files: si el archivo existe, servilo; si no (ruta interna de React
	# como /mi-diagrama), devolvé index.html para que el router del SPA
	# resuelva — sin esto, cada F5 en una ruta daría 404.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
