package {{packageName}}.assistant;

import java.net.URI;
import java.net.http.HttpClient;
import java.net.http.HttpRequest;
import java.net.http.HttpResponse;
import java.net.Proxy;
import java.net.ProxySelector;
import java.time.Duration;
import java.util.HashMap;
import java.util.Map;
import java.util.Optional;
import java.util.Set;
import java.util.logging.Logger;

/**
 * Clasificador de intenciones con Ollama — vía PRINCIPAL (diseño D11v2).
 * - Llama ÚNICAMENTE a Ollama en localhost (assistant:R1 — NO DEBE llamar a endpoints remotos).
 * - Usa ProxySelector.noProxy() para eludir proxies SOCKS inactivos en modo sin conexión.
 * - Rechaza de forma estricta URLs base que no sean de loopback al iniciar (invariante de código).
 * - Parseo estricto de JSON: valores fuera del enum = Optional vacío (assistant:R3).
 * - D11v2: soporta DELETE/UPDATE con id + extracción de atributos mediante salidas estructuradas.
 * Renderizado por templates/spring-backend/ollama-engine.hbs — no editar manualmente.
 */
public class OllamaEngine implements AssistantEngine {

    private static final Logger log = Logger.getLogger(OllamaEngine.class.getName());
    private static final Duration TIMEOUT = Duration.ofSeconds(60);

    /** Elude cualquier proxy (SOCKS, HTTP, etc.) — funciona en todas las versiones de Java. */
    private static final ProxySelector NO_PROXIES = new ProxySelector() {
        @Override public java.util.List<Proxy> select(URI uri) {
            return java.util.List.of(Proxy.NO_PROXY);
        }
        @Override public void connectFailed(URI uri, java.net.SocketAddress sa, java.io.IOException ioe) { }
    };

    private final HttpClient client;
    private final String chatUrl;
    private final String model;
    private final Set<String> knownEntities;
    private final String entitySchemaDescription;

    public OllamaEngine(String baseUrl, String model, Set<String> knownEntities,
                         String entitySchemaDescription) {
        URI uri = URI.create(baseUrl);
        String host = uri.getHost();
        if (host == null || (!host.equals("127.0.0.1") && !host.equals("localhost") && !host.equals("::1") && !host.equals("host.docker.internal"))) {
            throw new IllegalStateException(
                "Ollama base URL must be localhost/127.0.0.1 or host.docker.internal (assistant:R1) — got: " + host);
        }
        this.chatUrl = baseUrl + "/api/chat";
        this.model = model;
        this.knownEntities = knownEntities;
        this.entitySchemaDescription = entitySchemaDescription;
        this.client = HttpClient.newBuilder()
            .proxy(NO_PROXIES)
            .connectTimeout(TIMEOUT)
            .build();
    }

    @Override
    public Optional<Intent> classify(String freeText) {
        String prompt = buildPrompt(freeText);
        String json = "{\"model\":\"" + model + "\",\"messages\":[{\"role\":\"user\",\"content\":"
            + escapeJson(prompt)
            + "\"}],\"stream\":false,\"format\":{"
            + "\"type\":\"object\",\"properties\":{"
            + "\"action\":{\"type\":\"string\",\"enum\":[\"list\",\"count\",\"create\",\"delete\",\"update\"]},"
            + "\"entity\":{\"type\":\"string\"},"
            + "\"id\":{\"type\":\"integer\"},"
            + "\"fields\":{\"type\":\"object\"}"
            + "},\"required\":[\"action\",\"entity\"]}}";

        try {
            HttpRequest request = HttpRequest.newBuilder()
                .uri(URI.create(chatUrl))
                .header("Content-Type", "application/json")
                .POST(HttpRequest.BodyPublishers.ofString(json))
                .timeout(TIMEOUT)
                .build();
            HttpResponse<String> response = client.send(request, HttpResponse.BodyHandlers.ofString());
            if (response.statusCode() != 200) {
                log.warning("Ollama returned HTTP " + response.statusCode());
                return Optional.empty();
            }
            return parseResponse(response.body());
        } catch (Exception e) {
            log.warning("Ollama call failed: " + e.getMessage());
            return Optional.empty();
        }
    }

    private String buildPrompt(String freeText) {
        return "You are a database CRUD assistant. Convert the user's request into a JSON command.\n"
            + "Actions: list (show all), count (how many), create (add new), delete (remove by id), update (modify by id).\n"
            + "Entities available: " + String.join(", ", knownEntities) + ".\n"
            + entitySchemaDescription + "\n"
            + "Guidelines:\n"
            + "- 'entity': match the closest available entity name (case-sensitive). If user speaks Spanish, translate (e.g. usuario->User, producto->Product).\n"
            + "- 'id': for delete/update, extract any numeric ID mentioned (e.g. 1, 2, 3).\n"
            + "- 'fields': for create/update, extract whatever attributes the user mentioned as key-value pairs.\n"
            + "  * You do NOT need all attributes! Partial attributes are expected and completely valid.\n"
            + "  * If the user only says 'crea un usuario Carlos', put: {\"name\": \"Carlos\"}.\n"
            + "  * If the user doesn't mention any attributes, leave 'fields': {}.\n"
            + "  * Do NOT refuse or ask questions. Always output valid JSON.\n"
            + "- Format: {\"action\":\"...\",\"entity\":\"...\",\"id\":null,\"fields\":{...}}\n"
            + "User request: " + freeText;
    }

    private Optional<Intent> parseResponse(String responseBody) {
        try {
            String content = extractJsonContent(responseBody);
            if (content == null) return Optional.empty();
            String action = extractField(content, "action");
            String entity = extractField(content, "entity");
            if (action == null || entity == null) return Optional.empty();

            Intent.Action actionEnum = switch (action) {
                case "list" -> Intent.Action.LIST;
                case "count" -> Intent.Action.COUNT;
                case "create" -> Intent.Action.CREATE;
                case "delete" -> Intent.Action.DELETE;
                case "update" -> Intent.Action.UPDATE;
                default -> null;
            };
            if (actionEnum == null) return Optional.empty();

            // Re-validación del lado del servidor contra la lista blanca (assistant:R2)
            String validEntity = null;
            for (String known : knownEntities) {
                if (known.equalsIgnoreCase(entity)) {
                    validEntity = known;
                    break;
                }
            }
            if (validEntity == null) return Optional.empty();

            // Extraer ID opcional
            Long id = null;
            String idStr = extractField(content, "id");
            if (idStr != null) {
                try { id = Long.parseLong(idStr.replaceAll("[^0-9]", "")); } catch (NumberFormatException ignored) {}
            }

            // Extraer campos opcionales
            Map<String, String> fields = extractFields(content);

            return Optional.of(new Intent(actionEnum, validEntity, id, fields));
        } catch (Exception e) {
            log.warning("Failed to parse Ollama response: " + e.getMessage());
            return Optional.empty();
        }
    }

    private String extractJsonContent(String responseBody) {
        int idx = responseBody.indexOf("\"content\"");
        if (idx < 0) return null;
        int start = responseBody.indexOf('"', idx + 9) + 1;
        int end = responseBody.indexOf('"', start);
        if (start <= 0 || end < 0) return null;
        return responseBody.substring(start, end)
            .replace("\\\"", "\"")
            .replace("\\n", "\n");
    }

    private String extractField(String json, String field) {
        String key = "\"" + field + "\"";
        int idx = json.indexOf(key);
        if (idx < 0) return null;
        int colon = json.indexOf(':', idx + key.length());
        if (colon < 0) return null;
        // Omitir espacios en blanco después de dos puntos
        int pos = colon + 1;
        while (pos < json.length() && json.charAt(pos) == ' ') pos++;
        if (pos >= json.length()) return null;
        // Valor numérico (para id)
        if (Character.isDigit(json.charAt(pos))) {
            int numStart = pos;
            while (pos < json.length() && (Character.isDigit(json.charAt(pos)) || json.charAt(pos) == '.')) pos++;
            return json.substring(numStart, pos);
        }
        // Valor de cadena
        if (json.charAt(pos) == '"') {
            int start = pos + 1;
            int end = json.indexOf('"', start);
            if (end < 0) return null;
            return json.substring(start, end);
        }
        return null;
    }

    /** Extraer objeto de campos desde JSON (soporta cadenas entre comillas, números y booleanos). */
    private Map<String, String> extractFields(String json) {
        int idx = json.indexOf("\"fields\"");
        if (idx < 0) return null;
        int braceStart = json.indexOf('{', idx);
        if (braceStart < 0) return null;
        int depth = 0;
        int braceEnd = -1;
        for (int i = braceStart; i < json.length(); i++) {
            if (json.charAt(i) == '{') depth++;
            else if (json.charAt(i) == '}') { depth--; if (depth == 0) { braceEnd = i; break; } }
        }
        if (braceEnd < 0) return null;
        String s = json.substring(braceStart + 1, braceEnd).trim();
        if (s.isEmpty()) return new HashMap<>();

        Map<String, String> result = new HashMap<>();
        int i = 0;
        while (i < s.length()) {
            int kStart = s.indexOf('"', i);
            if (kStart < 0) break;
            int kEnd = s.indexOf('"', kStart + 1);
            if (kEnd < 0) break;
            String key = s.substring(kStart + 1, kEnd).trim();

            int colon = s.indexOf(':', kEnd + 1);
            if (colon < 0) break;

            int vStart = colon + 1;
            while (vStart < s.length() && (s.charAt(vStart) == ' ' || s.charAt(vStart) == '\t' || s.charAt(vStart) == '\n' || s.charAt(vStart) == '\r')) vStart++;
            if (vStart >= s.length()) break;

            String val;
            if (s.charAt(vStart) == '"') {
                int vEnd = s.indexOf('"', vStart + 1);
                if (vEnd < 0) break;
                val = s.substring(vStart + 1, vEnd);
                i = vEnd + 1;
            } else {
                int vEnd = vStart;
                while (vEnd < s.length() && s.charAt(vEnd) != ',' && s.charAt(vEnd) != '}' && !Character.isWhitespace(s.charAt(vEnd))) {
                    vEnd++;
                }
                val = s.substring(vStart, vEnd).trim();
                i = vEnd;
            }
            if (!key.isEmpty() && !val.isEmpty()) {
                result.put(key, val);
            }
        }
        return result.isEmpty() ? null : result;
    }

    private String escapeJson(String s) {
        return "\"" + s.replace("\\", "\\\\").replace("\"", "\\\"") + "\"";
    }
}
