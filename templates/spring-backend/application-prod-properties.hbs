# Configuración de Spring generada — perfil PRODUCTION (tarea 14.6b):
# PostgreSQL con credenciales proporcionadas puramente por variables de entorno —
# nada hardcodeado. Activar con SPRING_PROFILES_ACTIVE=prod.
# El esquema es administrado por JPA (ddl-auto=update); Flyway puede reemplazarlo luego.
# Renderizado por templates/spring-backend/application-prod-properties.hbs — no editar manualmente.
spring.application.name=generated-backend

spring.datasource.url=${SPRING_DATASOURCE_URL}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD}
spring.datasource.driver-class-name=org.postgresql.Driver

spring.jpa.hibernate.ddl-auto=update
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.open-in-view=false
