package {{packageName}}.web;

import {{packageName}}.assistant.AssistantEngine;
import {{packageName}}.assistant.IntentMatcher;
import {{packageName}}.assistant.OllamaEngine;
import {{packageName}}.assistant.OllamaProvisioner;
import {{packageName}}.assistant.AuditLog;
import {{packageName}}.assistant.AssistantEngine.Intent;
{{#each entities}}
import {{../packageName}}.{{this}};
import {{../packageName}}.service.{{this}}Service;
{{/each}}
import java.util.List;
import java.util.Map;
import java.util.Set;
import java.util.logging.Logger;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.http.HttpStatus;
import org.springframework.web.bind.annotation.*;

/**
 * Endpoint REST generado para el asistente sin conexión (diseño D11v2).
 * POST /api/assistant acepta una petición en texto libre y devuelve una respuesta
 * estructurada con resultado: executed | canned | unavailable | refused.
 *
 * Flujo D11v2: Ollama (primario) → IntentMatcher (respaldo cuando Ollama no está disponible).
 * Cada acción es auditada (assistant:R4).
 * Renderizado por templates/spring-backend/assistant-controller.hbs — no editar manualmente.
 */
@RestController
@RequestMapping("/api/assistant")
public class AssistantController {

    private static final Logger log = Logger.getLogger(AssistantController.class.getName());

    private static final Set<String> KNOWN_ENTITIES = Set.of(
        {{#each entities}}"{{this}}"{{#unless @last}}, {{/unless}}{{/each}}
    );

    /**
     * Esquemas de campos de entidades para el contexto del prompt de Ollama (D11v2).
     * Permite al modelo conocer los campos de cada entidad para extraer nombres
     * de atributos y valores a partir de lenguaje natural.
     */
    private static final String ENTITY_SCHEMA_DESCRIPTION =
{{#each entitySchemas}}
        "Entity {{name}}: fields={{#each fields}}{{name}}({{javaType}}){{#unless @last}}, {{/unless}}{{/each}}"{{#unless @last}} + "\n" +{{/unless}}{{#if @last}};{{/if}}
{{/each}}

    private static final String CAPABILITY_MESSAGE =
        "I can help you with: list records, count records, "
        + "create a record, delete a record by id, "
        + "or update a record by id. Try: 'list products' or 'delete product 3'.";

    private final IntentMatcher matcher;
    private final OllamaEngine ollama;
    private final OllamaProvisioner provisioner;
    private final AuditLog auditLog;
    {{#each entities}}
    private final {{this}}Service {{camel this}}Service;
    {{/each}}

    public AssistantController(
            OllamaProvisioner provisioner,
            @Value("${assistant.ollama.url:http://127.0.0.1:11434}") String ollamaUrl,
            @Value("${assistant.model:qwen2.5:1.5b}") String model,
            {{#each entities}}{{this}}Service {{camel this}}Service{{#unless @last}}, {{/unless}}{{/each}}
    ) {
        this.provisioner = provisioner;
        this.matcher = new IntentMatcher(KNOWN_ENTITIES);
        this.ollama = new OllamaEngine(ollamaUrl, model, KNOWN_ENTITIES, ENTITY_SCHEMA_DESCRIPTION);
        this.auditLog = new AuditLog();
        {{#each entities}}
        this.{{camel this}}Service = {{camel this}}Service;
        {{/each}}
    }

    @PostMapping
    public AssistantResponse handle(@RequestBody AssistantRequest request) {
        String text = request.request();
        if (text == null || text.isBlank()) {
            return new AssistantResponse("canned", null, null, CAPABILITY_MESSAGE);
        }

        // D11v2: Ollama es la vía PRINCIPAL — intentar primero si está disponible
        if (provisioner.isModelReady()) {
            try {
                Intent ollamaIntent = ollama.classify(text).orElse(null);
                if (ollamaIntent != null && ollamaIntent.isMatched()) {
                    // Re-validación del lado del servidor contra la lista blanca (assistant:R2)
                    if (!KNOWN_ENTITIES.contains(ollamaIntent.entityName())) {
                        auditLog.log("refused", "classify", text);
                        return new AssistantResponse("refused", null, null, CAPABILITY_MESSAGE);
                    }
                    return executeIntent(ollamaIntent, text);
                }
            } catch (Exception e) {
                log.warning("Ollama engine error: " + e.getMessage());
                // Continuar hacia el IntentMatcher
            }
        }

        // D11v2: IntentMatcher es el RESPALDO — determinista, sin red
        Intent matched = matcher.classify(text);
        if (matched.isMatched()) {
            // DELETE/UPDATE sin id desde el matcher sigue siendo usable para LIST/COUNT
            if ((matched.action() == Intent.Action.UPDATE || matched.action() == Intent.Action.CREATE)
                    && matched.fields() == null && !provisioner.isModelReady()) {
                auditLog.log("unavailable", matched.action().name().toLowerCase(), text);
                return new AssistantResponse("unavailable", matched.action().name().toLowerCase(),
                    matched.entityName(),
                    "This action requires the AI assistant (Ollama). Please install and start Ollama.");
            }
            return executeIntent(matched, text);
        }

        // Ninguna coincidencia
        auditLog.log("canned", "classify", text);
        return new AssistantResponse("canned", null, null, CAPABILITY_MESSAGE);
    }

    /** GET /api/assistant/status — reporta al cliente la disponibilidad de Ollama y el modelo. */
    @GetMapping("/status")
    public StatusResponse status() {
        return new StatusResponse(
            provisioner.isOllamaAvailable(),
            provisioner.getModel(),
            provisioner.isModelReady()
        );
    }

    private AssistantResponse executeIntent(Intent intent, String originalRequest) {
        String action = intent.action().name().toLowerCase();
        String entity = intent.entityName();

        try {
            return switch (intent.action()) {
                case LIST -> {
                    List<?> results = listEntity(entity);
                    auditLog.log("executed", action, originalRequest);
                    yield new AssistantResponse("executed", action, entity,
                        results != null ? results.toString() : "[]");
                }
                case COUNT -> {
                    List<?> results = listEntity(entity);
                    long count = results != null ? results.size() : 0;
                    auditLog.log("executed", action, originalRequest);
                    yield new AssistantResponse("executed", action, entity,
                        "Count: " + count);
                }
                case DELETE -> {
                    if (intent.id() == null) {
                        auditLog.log("refused", action, originalRequest);
                        yield new AssistantResponse("refused", action, entity,
                            "Please specify which " + entity + " to delete (e.g. 'delete " + entity + " 3').");
                    }
                    deleteEntity(entity, intent.id());
                    auditLog.log("executed", action, originalRequest);
                    yield new AssistantResponse("executed", action, entity,
                        entity + " " + intent.id() + " deleted successfully.");
                }
                case UPDATE -> {
                    Long targetId = intent.id();
                    if (targetId == null && intent.fields() != null && intent.fields().containsKey("id")) {
                        try { targetId = Long.parseLong(intent.fields().get("id").replaceAll("[^0-9]", "")); } catch (Exception ignored) {}
                    }
                    if (targetId == null) {
                        auditLog.log("refused", action, originalRequest);
                        yield new AssistantResponse("refused", action, entity,
                            "Please specify which " + entity + " to update by id (e.g. 'update " + entity + " 3').");
                    }
                    Map<String, String> fields = intent.fields() != null ? intent.fields() : Map.of();
                    Object updated = updateEntity(entity, targetId, fields);
                    auditLog.log("executed", action, originalRequest);
                    yield new AssistantResponse("executed", action, entity,
                        entity + " " + targetId + " updated: " + updated.toString());
                }
                case CREATE -> {
                    Map<String, String> fields = intent.fields() != null ? intent.fields() : Map.of();
                    Object created = createEntity(entity, fields);
                    auditLog.log("executed", action, originalRequest);
                    yield new AssistantResponse("executed", action, entity,
                        entity + " created: " + created.toString());
                }
            };
        } catch (Exception e) {
            auditLog.log("refused", action, originalRequest);
            return new AssistantResponse("refused", action, entity,
                "Could not execute " + action + " on " + entity + ": " + e.getMessage());
        }
    }

    private List<?> listEntity(String name) {
        {{#each entities}}
        if ("{{this}}".equals(name)) return {{camel this}}Service.findAll();
        {{/each}}
        return null;
    }

    private void deleteEntity(String name, Long id) {
        {{#each entities}}
        if ("{{this}}".equals(name)) { {{camel this}}Service.deleteById(id); return; }
        {{/each}}
        throw new IllegalArgumentException("Unknown entity: " + name);
    }

    private Object updateEntity(String name, Long id, Map<String, String> fields) {
        {{#each entities}}
        if ("{{this}}".equals(name)) {
            {{this}} entity = {{camel this}}Service.findById(id);
            {{this}}.applyFields(entity, fields);
            return {{camel this}}Service.save(entity);
        }
        {{/each}}
        throw new IllegalArgumentException("Unknown entity: " + name);
    }

    private Object createEntity(String name, Map<String, String> fields) {
        {{#each entities}}
        if ("{{this}}".equals(name)) {
            {{this}} entity = new {{this}}();
            {{this}}.applyFields(entity, fields);
            {{this}}.applyDefaults(entity);
            return {{camel this}}Service.save(entity);
        }
        {{/each}}
        throw new IllegalArgumentException("Unknown entity: " + name);
    }

    /** DTO de petición para POST /api/assistant. */
    public record AssistantRequest(String request) {}

    /** DTO de respuesta para POST /api/assistant. */
    public record AssistantResponse(String outcome, String action, String entity, String response) {}

    /** DTO de estado para GET /api/assistant/status. */
    public record StatusResponse(boolean ollama, String model, boolean ready) {}
}
