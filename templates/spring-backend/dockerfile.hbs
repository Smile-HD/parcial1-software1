# Imagen de contenedor generada: compilación multi-etapa para ejecución Docker sin configuración.
# Etapa 1: Compilar la aplicación Spring Boot usando Maven 3.9 + Java 21.
FROM maven:3.9-eclipse-temurin-21-alpine AS build
WORKDIR /app
COPY pom.xml .
COPY src ./src
RUN --mount=type=cache,target=/root/.m2 mvn clean package -DskipTests

# Etapa 2: Imagen de ejecución mínima con el jar empaquetado de Spring Boot.
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
COPY --from=build /app/target/*.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
