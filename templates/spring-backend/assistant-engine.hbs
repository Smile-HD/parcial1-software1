package {{packageName}}.assistant;

import java.util.Map;
import java.util.Optional;

/**
 * Puerto para clasificación de intenciones (diseño D11 / D11v2).
 * Las implementaciones NO deben llamar a endpoints de IA remotos (assistant:R1).
 * Renderizado por templates/spring-backend/assistant-engine.hbs — no editar manualmente.
 */
public interface AssistantEngine {

    /**
     * Clasifica texto libre en una intención estructurada.
     * Retorna un Optional vacío cuando el motor no puede clasificar con suficiente confianza.
     */
    Optional<Intent> classify(String freeText);

    /** Intención clasificada: acción + nombre de entidad + id opcional y campos. */
    record Intent(Action action, String entityName, Long id, Map<String, String> fields) {
        public enum Action { LIST, COUNT, CREATE, DELETE, UPDATE }
        public static final Intent UNMATCHED = new Intent(null, null, null, null);
        public boolean isMatched() { return action != null && entityName != null; }
    }
}
