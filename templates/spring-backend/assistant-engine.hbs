package {{packageName}}.assistant;

import java.util.Map;
import java.util.Optional;

/**
 * Port for intent classification (design D11 / D11v2).
 * Implementations must NOT call remote AI endpoints (assistant:R1).
 * Rendered by templates/spring-backend/assistant-engine.hbs — do not edit by hand.
 */
public interface AssistantEngine {

    /**
     * Classify free text into a structured intent.
     * Returns empty Optional when the engine cannot classify with confidence.
     */
    Optional<Intent> classify(String freeText);

    /** Classified intent: action + entity name + optional id and fields. */
    record Intent(Action action, String entityName, Long id, Map<String, String> fields) {
        public enum Action { LIST, COUNT, CREATE, DELETE, UPDATE }
        public static final Intent UNMATCHED = new Intent(null, null, null, null);
        public boolean isMatched() { return action != null && entityName != null; }
    }
}
