# .env.example — plantilla de configuración del deploy.
# CÓMO SE USA: copiar a deploy/.env (gitignoreado) y llenar con valores
# REALES en la EC2. Este archivo de ejemplo jamás tiene secretos.
# docker compose lee deploy/.env automáticamente para interpolar ${VARS}.

# ── Database ────────────────────────────────────────────────────────────
# Connection string de Postgres. ATENCIÓN al host: "postgres" es el NOMBRE
# DEL SERVICIO de compose (DNS interno entre containers), no localhost —
# localhost adentro del container de api sería el propio api.
DATABASE_URL=postgres://postgres:CHANGEME@postgres:5432/ai_uml

# ── API ─────────────────────────────────────────────────────────────────
# Puerto interno del backend DENTRO del container (Caddy hace proxy a api:3000;
# este puerto nunca se publica al mundo).
PORT=3000

# ── Collab server (Yjs/WebSocket) ───────────────────────────────────────
COLLAB_PORT=1234
COLLAB_HOST=0.0.0.0     # escuchar todas las interfaces del container

# ── OpenAI / LLM (ausentes ⇒ la app usa fakes deterministas, modo demo) ─
# La key es SERVER-SIDE: solo la ve el contenedor api; nunca viaja al navegador.
OPENAI_API_KEY=
OPENAI_BASE_URL=        # opcional: endpoint alternativo (proxy, Bedrock-compatible, etc.)
LLM_MODEL=gpt-4o        # generación/edición de diagramas por lenguaje natural
WHISPER_MODEL=whisper-1 # transcripción de notas de voz
VISION_MODEL=gpt-4o     # análisis de imágenes de diagramas

# ── Build-time (Vite) — se HORNEAN en el bundle JS, no son env de runtime ─
# Por eso cambian requiriendo docker compose build, no basta con restart.
VITE_API_URL=/api            # ruta relativa: mismo origen → sin CORS
VITE_COLLAB_URL=             # lo fija el compose a wss://<PUBLIC_DOMAIN>/collab

# ── Dominio público (Route 53) ──────────────────────────────────────────
# Dominio real registrado en AWS Route 53 con un registro A apuntando a la
# Elastic IP de la EC2. Alimenta DOS cosas: (1) el site block del Caddyfile
# (emisión/renovación automática del certificado ACME), (2) el VITE_COLLAB_URL
# horneado arriba. DEBE resolver al servidor ANTES del primer compose up.
# Formato: solo el hostname, sin https:// ni barra final. Ej: uml.midominio.com
PUBLIC_DOMAIN=
